AI_MODEL=glm-5.3-flash
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# 使用本机既有 OpenCode Go 凭据，仅服务端读取；或改用 OPENAI_API_KEY。
OPENCODE_AUTH_FILE=C:/Users/你的用户名/.local/share/opencode/auth.json
PENPOT_MCP_URL=http://localhost:4401/mcp
# 从目标设计 URL 获取；必须运行包含新工具的 Server 和 Plugin。
PENPOT_FILE_ID=11111111-1111-4111-8111-111111111111
PENPOT_PAGE_ID=22222222-2222-4222-8222-222222222222
# 多用户和多会话场景再配置以下变量。
# PENPOT_MCP_TOKEN=
# PENPOT_SESSION_ID=
