AI_MODEL=glm-5.3-flash
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# 使用本机既有 OpenCode Go 凭据，仅服务端读取；或改用 OPENAI_API_KEY。
OPENCODE_AUTH_FILE=C:/Users/你的用户名/.local/share/opencode/auth.json
PENPOT_MCP_URL=http://localhost:4401/mcp
# 从目标设计 URL 获取；必须运行包含新工具的 Server 和 Plugin。
PENPOT_FILE_ID=11111111-1111-4111-8111-111111111111
PENPOT_PAGE_ID=22222222-2222-4222-8222-222222222222
# 多用户和多会话场景再配置以下变量。
# PENPOT_MCP_TOKEN=
# PENPOT_SESSION_ID=

# Phase 1 原生服务：通过同源 /api/agent/ 代理到本服务。
PENPOT_AGENT_ORIGIN=https://localhost:3449
PENPOT_BACKEND_URL=http://127.0.0.1:6060/
PENPOT_AGENT_MCP_URL=http://localhost:4401/mcp/agent
PENPOT_AGENT_PORT=4404
# 可选：逗号分隔的模型白名单，未设置时使用 AI_MODEL。
# AI_MODELS=glm-5.3-flash

# Phase 4：AI_MODELS 中用于截图识别的模型必须支持图片输入与结构化输出。
# 图片模型独立配置；不配置时仍可使用截图识别和代码导出。
# 端点需兼容 images/generations 与 images/edits，并返回 PNG b64_json。
# AI_IMAGE_MODEL=你的图片模型名称
# AI_IMAGE_BASE_URL=https://你的模型服务/v1/
# AI_IMAGE_API_KEY=仅服务端读取的图片服务密钥
# AI_IMAGE_LICENSE=供应商条款链接或内部授权说明
